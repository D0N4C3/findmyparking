{
  "expo": {
    "name": "FindMyParking",
    "slug": "findmyparking-qyv22uyaixxn13rdbbij",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.interethiopia.findmyparking",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CarPing needs your location to save your parking spot and guide you back to your car.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CarPing uses background location to support optional car auto-detection and reminders.",
        "NSUserNotificationUsageDescription": "CarPing sends parking reminders and timer alerts.",
        "NSBluetoothAlwaysUsageDescription": "CarPing uses Bluetooth to detect when your car disconnects so it can save your parking location.",
        "NSBluetoothPeripheralUsageDescription": "CarPing uses Bluetooth to detect when your car disconnects so it can save your parking location."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.interethiopia.findmyparking",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "react-native-ble-plx"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "15c9872e-dde4-4af4-a51b-c5227e167a4f"
      }
    }
  }
}
